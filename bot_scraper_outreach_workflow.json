    {
      "parameters": {
        "jsCode": "const validLeads = [];\n\nfor (const item of $input.all()) {\n  // Extraemos todos los posibles nombres que usa Apify para el teléfono\n  let rawPhone = item.json.phoneUnformatted || item.json.phoneNumber || item.json.phone || item.json.cellphone || \"\";\n  let rawName = item.json.title || item.json.name || item.json.companyName || \"Empresa\";\n\n  // Forzamos a String para evitar que .replace falle si llega un Integer\n  let phone = String(rawPhone).trim();\n  let name = String(rawName).trim();\n\n  if (phone && phone !== \"undefined\" && phone !== \"null\") {\n    // Eliminamos todo lo que no sea numero\n    phone = phone.replace(/\\D/g, '');\n\n    if (phone.length > 0) {\n      // Formateo para Argentina / Mendoza (API de WhatsApp requiere 549)\n      if (phone.startsWith('54') && !phone.startsWith('549')) {\n         phone = '549' + phone.substring(2);\n      } else if (phone.startsWith('261')) {\n         phone = '549' + phone;\n      } else if (phone.startsWith('0261')) {\n         phone = '549' + phone.substring(1);\n      } else if (!phone.startsWith('54')) {\n         // Si es un número local (ej: 4234567), agregamos 549261 directamente\n         if (phone.length === 7) {\n             phone = '549261' + phone;\n         } else if (phone.startsWith('0')) {\n             phone = '549' + phone.substring(1);\n         } else {\n             phone = '549' + phone;\n         }\n      }\n\n      // Parche: quitar el \"15\" de los celulares (ej: 549261154...) si quedó atrapado\n      phone = phone.replace(/^549(\\d{3,4})15(\\d{6,7})$/, '549$1$2');\n\n      // Verificamos que tenga largo válido de celular para WhatsApp (entre 12 y 14 dígitos)\n      if (phone.length >= 12 && phone.length <= 14) {\n        validLeads.push({\n          json: {\n            nombre_empresa: name,\n            telefono_limpio: \"+\" + phone\n          }\n        });\n      }\n    }\n  }\n}\n\nreturn validLeads;"
      },
